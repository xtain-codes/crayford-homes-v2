# Crayford — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Database (required) ─────────────────────────────────────────────────────
# SQLite for local dev. For production, switch prisma/schema.prisma to
# provider = "postgresql" and use a Postgres connection string.
DATABASE_URL="file:./dev.db"

# ── Auth (required) ─────────────────────────────────────────────────────────
# Long random string used to sign admin session cookies (sessions last 7 days).
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Paystack (required for live payments on /book) ──────────────────────────
# Get keys at dashboard.paystack.com → Settings → API Keys & Webhooks
# Public key is exposed to the browser (safe by design); secret key never leaves the server.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Resend (required for "payment received" emails) ─────────────────────────
# Get a key at resend.com → API Keys
RESEND_API_KEY=
# The verified sender, e.g. "Crayford <bookings@yourdomain.com>"
EMAIL_FROM=

# ── Optional: seed admin credentials (used by `npm run db:seed`) ────────────
# Defaults to admin@crayford.local / CrayfordAdmin2026! when unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
